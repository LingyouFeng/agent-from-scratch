/* ====== 左侧边栏 ====== */
#sidebar {
    width: 30; /* 固定宽度，可按需调整 */
    height: 1fr;
    background: $surface;
    border-right: solid $panel;
    padding: 1;
}

#new-chat-btn {
    width: 100%;
    margin-bottom: 1;
}

#chat-list {
    height: 1fr;
    background: transparent;
}

/* 列表项本身 */
#chat-list ListItem {
    height: auto;
    padding: 0; /* 移除默认 padding */
    margin-bottom: 1;
    border-left: thick transparent; /* 预留左侧边框高亮 */
}

/* 选中或悬停时的视觉反馈 */
#chat-list ListItem:hover {
    background: $surface-lighten-1;
}

#chat-list ListItem.-highlight {
    background: $primary-darken-2;
    border-left: thick $primary;
}

/* 会话项行：左侧内容 + 右侧删除按钮 */
.chat-item-row {
    width: 100%;
    height: auto;
    align: center middle;
}

/* 内部文本容器 */
.chat-item-content {
    width: 1fr; /* 占满剩余宽度，把删除按钮挤到最右侧 */
    padding: 1 1; /* 为整个内容区提供上下左右的呼吸感 */
    height: auto;
}

/* 删除按钮：默认隐藏，仅在选中或悬浮该会话项时出现 */
.chat-delete-btn {
    display: none;
    width: 3;
    min-width: 3;
    height: 3;
    padding: 0;
    margin: 0 1 0 0;
    border: none;
}

#chat-list ListItem:hover .chat-delete-btn,
#chat-list ListItem.-highlight .chat-delete-btn {
    display: block;
}

/* 标题样式 */
.chat-title {
    text-style: bold;
    color: $text;
    height: auto;
}

/* 预览样式 */
.chat-preview {
    color: $text-muted;
    height: auto;
    text-overflow: ellipsis; /* 太长时显示省略号 */
    overflow: hidden;
}
