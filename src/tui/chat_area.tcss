/* ====== 右侧聊天区域 ====== */
#chat-area {
    width: 1fr;
    height: 1fr;
}

/* 会话视图容器：同时挂多个 ConversationView，靠 display 切换 */
#views {
    height: 1fr;
}

/* ====== 会话消息视图（每个会话一份） ====== */
ConversationView {
    height: 1fr;
    padding: 1;
    scrollbar-gutter: stable;
    background: $background; /* 显式指定深色底，确保间隙是纯正的暗色 */

    /* 美化滚动条 */
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $surface-lighten-1;
    scrollbar-color-hover: $surface-lighten-2;
    scrollbar-color-active: $primary;
}

/* 核心：统一给日志里的直接子元素下发 1 格的顶部间距 */
ConversationView > * {
    margin-right: 3;
    margin-top: 1;
}

/* 确保日志里的第一个元素没有顶部间距，贴紧顶部 */
ConversationView > :first-child {
    margin-top: 0;
}

/* ====== 输入区容器（输入行 + 状态行） ====== */
#input-area {
    width: 100%;
    height: auto;
    dock: bottom;
    padding: 1;
    margin-top: 1;
    background: $surface;
}

#input-row {
    width: 100%;
    height: auto;
    align: center middle;
}

/* ====== 输入栏下方状态行 ====== */
#status-row {
    width: 100%;
    height: auto;
    margin-top: 1;
    align: center middle;
}

/* 左侧 token 信息 / 右侧思考强度：与 Select 等高并垂直居中 */
#token-usage,
#context-tokens,
#thinking-level {
    width: auto;
    height: 3;
    padding: 0 1;
    content-align: center middle;
    color: $text-muted;
}

/* 弹性占位：把右侧内容推到最右 */
.status-spacer {
    width: 1fr;
    height: 3;
}

/* ====== 文本框 ====== */
#prompt {
    width: 1fr;
    height: 3;
    margin: 0;
    border: tall $surface-lighten-2;
}

/* ====== 模型选择器 ====== */
#model-select {
    width: 40;
    margin: 0;
}

#prompt:focus {
    border: tall $primary;
}

/* ====== 发送按钮 ====== */
#send {
    width: 8;
    min-width: 8;
    height: 3;
    margin: 0 0 0 1;
    padding: 0;
    content-align: center middle;
}

/* ====== 用户消息行 ====== */
.user-msg-row {
    width: 100%;
    height: auto;
    align: right middle;
    margin: 0;
    padding: 0;
}

.user-msg-wrapper {
    width: auto;
    height: auto;
    max-width: 85%;
    align: right middle;
    margin: 0;
    padding: 0;
}

.user-msg-bubble {
    width: auto;
    height: auto;
    background: $primary-darken-2;
    color: $text;
    padding: 1 2;
    margin: 0;
}

.user-msg-meta {
    width: auto; /* 修复文字短时变成两行的问题 */
    height: auto;
    color: $text-muted;
    text-style: italic;
    margin: 0;
    padding: 0;
}

/* ====== 正文 ====== */
.agent-msg {
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
}

/* ====== 思考过程折叠框 ====== */
Collapsible.thinking-collapsible {
    border-left: thick $surface-lighten-3;
    background: transparent;
}

/* 标题：单行显示，超出的部分用省略号截断 */
Collapsible.thinking-collapsible > CollapsibleTitle {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;        /* 关键：强制单行，禁止换行 */
    text-overflow: ellipsis;  /* 溢出部分显示为省略号 */
    overflow: hidden;         /* 可选：确保隐藏其他溢出内容 */
}

.thinking {
    color: $text-muted;
    text-style: italic;
    background: transparent;
}

/* 工具执行框：统一改为仅保留左侧竖线，背景透明 */
Collapsible.tool-exec,
Collapsible.tool-exec-ok,
Collapsible.tool-exec-fail,
Collapsible.tool-exec-running {
    background: transparent;          /* 背景透明，与父容器一致 */
    border: none;                     /* 清除全包围边框 */
    border-left: thick $primary;      /* 只保留左侧竖线，颜色可按需调整 */
}

/* 不同状态可微调竖线颜色以示区分（可选） */
Collapsible.tool-exec-running {
    border-left: thick $warning;
}
Collapsible.tool-exec-ok {
    border-left: thick $success;
}
Collapsible.tool-exec-fail {
    border-left: thick $error;
}

/* 运行中参数和结束结果的内部样式 */
.tool-args-body,
.tool-result-body {
    padding: 0 1;
    background: transparent; /* 关键：内部透明 */
    color: $text;
    margin: 0;
}
.tool-body-container {
    height: auto;
}

/* ====== 其他 ====== */
.error {
    color: $error;
    padding-left: 1;
    margin: 0;
}