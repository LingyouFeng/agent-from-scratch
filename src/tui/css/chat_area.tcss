/* ====== 右侧聊天区域 ====== */
#chat-area {
    width: 1fr;
    height: 1fr;
}

/* 会话视图容器：同时挂多个 ConversationView，靠 display 切换 */
#views {
    height: 1fr;
}

/* ====== 会话消息视图（每个会话一份） ====== */
ConversationView {
    height: 1fr;
    padding: 1;
    scrollbar-gutter: stable;
    background: $background; /* 显式指定深色底，确保间隙是纯正的暗色 */

    /* 美化滚动条 */
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $surface-lighten-1;
    scrollbar-color-hover: $surface-lighten-2;
    scrollbar-color-active: $primary;
}

/* 核心：统一给日志里的直接子元素下发 1 格的顶部间距 */
ConversationView > * {
    margin-right: 3;
    margin-top: 1;
}

/* 确保日志里的第一个元素没有顶部间距，贴紧顶部 */
ConversationView > :first-child {
    margin-top: 0;
}

/* ====== 消息分页：每页只承载有限条消息，避免长会话一次性布局 ====== */
ConversationView > .message-page {
    width: 100%;
    height: auto;
    margin: 0;
}

.message-page > * {
    margin-right: 3;
    margin-top: 1;
}

.load-earlier {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $boost;
    color: $text-muted;
}

.load-earlier:hover {
    background: $primary-darken-2;
    color: $text;
}

/* ====== 输入区容器（输入框 + 底部右侧操作区） ====== */
#input-area {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1; /* 与下方统计栏/明细面板留出间隙 */
    padding: 0 1;
    background: $surface;
    border: tall $surface-lighten-2;
}

/* 输入区里任意控件获得焦点时，整条输入区高亮 */
#input-area:focus-within {
    border: tall $primary;
}

/* ====== 文本框：单行输入，自身不再画边框 ====== */
#prompt {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
}

#prompt:focus {
    border: none;
}

/* ====== 输入区底部：模型选择 + 圆形发送按钮，固定在右下 ====== */
#composer-toolbar {
    width: 100%;
    height: 3;
    margin: 0;
}

#composer-actions {
    dock: right;
    width: auto;
    height: 3;
}

#model-select {
    width: 38;
    height: 1;
    margin-top: 1; /* 与发送按钮的箭头行对齐 */
    border: none !important;
    padding: 0;
    background: transparent;
}

#model-select > SelectCurrent {
    border: none !important;
    padding: 0 2;
    height: 1;
    background: transparent;
    content-align: left middle;
}

/* 圆形发送按钮：5x3 圆角边框 + 图标；hover 填充，聚焦只换边框 */
#send {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0 0 0 1;
    padding: 0;
    border: round $primary;
    background: transparent;
    color: $primary;
    content-align: center middle;
}

#send:hover {
    background: $primary;
    color: $text;
}

#send:focus {
    border: round $primary-lighten-2;
}

#send.-error {
    border: round $error;
    background: transparent;
    color: $error;
}

#send.-error:hover {
    background: $error;
    color: $text;
}

#send:disabled {
    border: round $surface-lighten-2;
    background: transparent;
    color: $text-muted;
}

/* ====== 统计栏：轮数/部署 | Token 汇总（点击展开明细） | 上下文使用率 ====== */
#session-stats {
    width: 100%;
    height: 1;
    padding: 0 2;
    margin-bottom: 1; /* 与窗口底部留出呼吸空间 */
    background: transparent; /* 与窗口背景一致 */
}

#stat-turns {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#stat-tokens {
    width: auto;
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

#stat-tokens:hover {
    color: $text;
    background: $boost;
    text-style: underline;
}

#stat-context {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

/* ====== Token 明细浮层（悬浮在统计栏上方，不挤占消息区） ====== */
UsagePopup {
    background: transparent;
    align-horizontal: left;
    align-vertical: top;
    overflow: hidden;
}

#usage-panel {
    width: 100%;
    height: auto;
    dock: bottom;
    padding: 0 1;
    background: $surface;
    border: round $primary;
}

#usage-head {
    width: 100%;
    height: 1;
}

#usage-title {
    width: auto;
    height: 1;
    text-style: bold;
    color: $text;
}

#usage-subtitle {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

.usage-col {
    height: auto;
}

.usage-row {
    height: 1;
}

.usage-label {
    width: 13;
    height: 1;
    padding-left: 1;
    color: $text-muted;
}

.usage-value {
    width: 1fr;
    height: 1;
    padding-right: 2;
    color: $text;
    content-align: right middle;
}

/* ====== 用户消息行 ====== */
.user-msg-row {
    width: 100%;
    height: auto;
    align: right middle;
    margin: 0;
    padding: 0;
}

.user-msg-wrapper {
    width: auto;
    height: auto;
    max-width: 85%;
    align: right middle;
    margin: 0;
    padding: 0;
}

.user-msg-bubble {
    width: auto;
    height: auto;
    background: $primary-darken-2;
    color: $text;
    padding: 1 2;
    margin: 0;
}

.user-msg-meta {
    width: auto; /* 修复文字短时变成两行的问题 */
    height: auto;
    color: $text-muted;
    text-style: italic;
    margin: 0;
    padding: 0;
}

/* ====== 正文 ====== */
.agent-msg {
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
}

/* ====== 思考过程折叠框 ====== */
Collapsible.thinking-collapsible {
    border-left: thick $surface-lighten-3;
    background: transparent;
}

/* 标题：单行显示，超出的部分用省略号截断 */
Collapsible.thinking-collapsible > CollapsibleTitle {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;        /* 关键：强制单行，禁止换行 */
    text-overflow: ellipsis;  /* 溢出部分显示为省略号 */
    overflow: hidden;         /* 可选：确保隐藏其他溢出内容 */
}

.thinking {
    color: $text-muted;
    text-style: italic;
    background: transparent;
}

/* 工具执行框：统一改为仅保留左侧竖线，背景透明 */
Collapsible.tool-exec,
Collapsible.tool-exec-ok,
Collapsible.tool-exec-fail,
Collapsible.tool-exec-running {
    background: transparent;          /* 背景透明，与父容器一致 */
    border: none;                     /* 清除全包围边框 */
    border-left: thick $primary;      /* 只保留左侧竖线，颜色可按需调整 */
}

/* 不同状态可微调竖线颜色以示区分（可选） */
Collapsible.tool-exec-running {
    border-left: thick $warning;
}
Collapsible.tool-exec-ok {
    border-left: thick $success;
}
Collapsible.tool-exec-fail {
    border-left: thick $error;
}

/* 运行中参数和结束结果的内部样式 */
.tool-args-body,
.tool-result-body {
    padding: 0 1;
    background: transparent; /* 关键：内部透明 */
    color: $text;
    margin: 0;
    /* 限高滚动：长命令/长输出不再把工具卡片撑满整个屏幕 */
    max-height: 10;
    overflow-y: auto;
}
.tool-body-container {
    height: auto;
}

/* ====== 其他 ====== */
.error {
    color: $error;
    padding-left: 1;
    margin: 0;
}