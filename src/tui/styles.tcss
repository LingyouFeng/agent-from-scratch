/* ====== 日志区 ====== */
#log {
    height: 1fr;
    padding: 1 1 1 2;
    scrollbar-gutter: stable;

    /* 美化滚动条 */
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-color: $surface-lighten-1;
    scrollbar-color-hover: $surface-lighten-2;
    scrollbar-color-active: $primary;
}

/* 给日志里所有直接子元素右侧加间距 */
#log > * {
    margin-right: 3;
}

/* ====== 状态栏 ====== */
#statusbar {
    height: auto;
    max-height: 10;
    padding: 1 2; /* 与日志区的 2 对齐 */
    background: $boost;
    border-top: solid $surface-lighten-2; /* 改成暗色，不再用刺眼的主题蓝 */
}

/* ====== 输入区容器 ====== */
#input-row {
    height: 4; /* 增加一点高度，让上下有留白 */
    width: 100%;
    padding: 0 2; /* 左侧留白 2，与日志对齐 */
    margin-top: 1;    /* 新增：与上方的状态栏拉开 1 格距离 */
    align: center middle;
}

/* ====== 文本框 ====== */
#prompt {
    width: 1fr;
    height: 3;
    margin: 0; /* 去掉 margin，对齐完全交给父容器处理 */
    border: tall $surface-lighten-2; /* 默认状态使用暗色边框 */
}

#prompt:focus {
    border: tall $primary; /* 只有聚焦时才亮起 */
}

/* ====== 发送按钮 ====== */
#send {
    width: 8;
    min-width: 8;
    height: 3;
    margin: 0 0 0 1; /* 仅留左侧 1 格间距，与输入框隔开 */
    padding: 0;
    content-align: center middle;
}

/* ====== 用户消息行（用于控制靠右） ====== */
.user-msg-row {
    width: 100%;
    height: auto;
    align: right middle;
}

/* ====== 用户消息组合（气泡 + 时间） ====== */
.user-msg-wrapper {
    width: auto;
    height: auto;
    max-width: 85%;
    align: right middle;
}

/* ====== 用户消息气泡 ====== */
.user-msg-bubble {
    width: auto;
    height: auto;
    background: $primary-darken-2;
    color: $text;
    padding: 1 2;
}

/* ====== 下方灰色的 You 和时间 ====== */
.user-msg-meta {
    width: 100%;
    height: auto;
    color: $text-muted;   /* 灰色字体 */
    text-style: italic;
    text-align: right;
}

.agent-msg {
    margin-bottom: 1;
}

/* ====== 思考过程折叠框 ====== */
Collapsible.thinking-collapsible {
    margin: 1 0 1 1;                    /* 左侧留白，上下拉开 */
    border: round $surface-lighten-2;   /* 暗色边框，低调 */
    background: $surface;
}

.thinking {
    color: $text-muted;
    text-style: italic;
    padding: 1;                         /* 展开后内部文字留点空间 */
}

.tool-call {
    color: $warning;
    padding-left: 1;
    margin-bottom: 1;
}

.tool-result {
    color: $success;
    padding-left: 1;
    margin-bottom: 1;
}

.error {
    color: $error;
    padding-left: 1;
    margin-bottom: 1;
}

.turn-divider {
    color: $text-muted;
    padding: 0 1;
    margin: 1 0 0 0;
}

.tool-exec {
    margin: 0 0 0 1;
    padding: 0 1;
    border-left: thick $primary;
    background: $surface;
}

.tool-exec-running {
    border-left: thick $warning;
}

Collapsible.tool-exec-ok {
    margin: 0 0 1 1;
    border: round $success;
    background: $surface;
}

Collapsible.tool-exec-fail {
    margin: 0 0 1 1;
    border: round $error;
    background: $surface;
}

.tool-result-body {
    padding: 1;
    background: $surface;
    color: $text;
}